{
  "info": {
    "name": "Authentication und Permissions – Workshop",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Environment \"Auth lokal\" aktivieren. Requests einzeln in der Reihenfolge der Übung ausführen. Vor dem Löschen per Staff zuerst eine neue Teststation mit einem freien create_code anlegen."
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "01 Identitaet",
      "item": [
        {
          "name": "Liste ohne Token",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{basis_url}}api/stations/"
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Liste als Owner",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{owner_token}}",
                "type": "text"
              }
            ],
            "url": "{{basis_url}}api/stations/"
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Liste mit ungueltigem Token",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Token invalid-demo-token",
                "type": "text"
              }
            ],
            "url": "{{basis_url}}api/stations/"
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"Token-Challenge\", function () {",
                  "  pm.expect(pm.response.headers.get(\"WWW-Authenticate\"))",
                  "    .to.eql(\"Token\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

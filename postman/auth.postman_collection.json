                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Station als Bob erstellen",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{other_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{basis_url}}api/stations/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{create_code}}\",\n  \"name\": \"Auth Workshop Station\",\n  \"latitude\": \"48.100000\",\n  \"longitude\": \"11.500000\",\n  \"active\": true,\n  \"owner\": {{owner_id}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set(\"created_station_id\",",
                  "    pm.response.json().id);",
                  "}",
                  "pm.test(\"Owner unveraendert\", function () {",
                  "  pm.expect(pm.response.json().owner)",
                  "    .to.eql(Number(pm.environment.get(\"other_id\")));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Neue Station als Bob lesen",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{other_token}}",
                "type": "text"
              }
            ],
            "url": "{{basis_url}}api/stations/{{created_station_id}}/"
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Owner unveraendert\", function () {",
                  "  pm.expect(pm.response.json().owner)",
                  "    .to.eql(Number(pm.environment.get(\"other_id\")));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Fremde Station als Bob patchen",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "noauth"
            },
